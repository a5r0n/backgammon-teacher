# Cloudflare Workers Environment
# These are set via wrangler secrets or wrangler.jsonc bindings

# LLM Configuration
LLM_PROVIDER=workers-ai  # Options: workers-ai, anthropic, openai, mock
LLM_API_KEY=             # Required for anthropic/openai providers

# Google OAuth
PUBLIC_GOOGLE_CLIENT_ID=  # Google OAuth client ID

# AI Gateway (optional — routes LLM calls through CF AI Gateway)
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_NAME=
